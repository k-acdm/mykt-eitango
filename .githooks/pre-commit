#!/bin/sh
# index.html が staged にあるとき、scripts/stamp-version.js を自動実行して
# バージョン番号を最新の JST タイムスタンプに更新する。
# 2026-05-28 新設（手動 stamp 忘れによる「v が古いまま」を構造的に防止）。
#
# 初回セットアップ：リポジトリのルートで一度だけ以下を実行する：
#   git config core.hooksPath .githooks
# 以降、index.html を含む commit のたびに自動で stamp される。

CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^index\.html$' || true)
if [ -z "$CHANGED" ]; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node コマンドが見つかりません。stamp-version をスキップします。"
  exit 0
fi

echo "[pre-commit] index.html が変更されているため stamp-version.js を実行します..."
node scripts/stamp-version.js
if [ $? -ne 0 ]; then
  echo "[pre-commit] stamp-version.js が失敗しました。commit を中断します。"
  exit 1
fi

# stamp 後の index.html を staged に再追加（差分が出ていた場合のみ）
git add index.html
exit 0
